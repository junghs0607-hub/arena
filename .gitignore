# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# 파이프라인 산출물 (용량 큼 — 금고 밖에 보관)
work/
jobs/
remotion/public/timeline.json
output/*.mp4
output/*.webm
output/*.srt

# 사용자 소유 미디어 (AI 생성 파일 / 녹음 나레이션)
assets/media/*
!assets/media/.gitkeep

# SQLite 설정 스토어 (관리자 계정 포함 — 저장소에 올리지 않음)
data/*.db
data/*.db-journal

# 자동 다운로드되는 자막 폰트 (라이센스 별도 확인용 — 필요 시 수동 배치)
assets/fonts/
assets/bgm/*
!assets/bgm/.gitkeep
assets/narration/*
!assets/narration/.gitkeep

# 로컬 전용 LLM 설정 (키/엔드포인트 커밋 방지)
admin/llm.local.json
